cabal-version: 3.0
name:          vpn-router
version:       0.0.5

synopsis:      Switch VPN with web interface for LAN
description:
homepage:      http://github.com/yaitskov/vpn-router
license:       BSD-3-Clause
license-file:  LICENSE
author:        Daniil Iaitskov
maintainer:    dyaitskov@gmail.com
copyright:     Daniil Iaitkov 2026
category:      System
build-type:    Simple
bug-reports:   https://github.com/yaitskov/vpn-router/issues
extra-doc-files:
  changelog.md
tested-with:
  GHC == 9.12.2

source-repository head
  type:
    git
  location:
    https://github.com/yaitskov/vpn-router.git

flag server-only
     description: skip building UI that generates JS bundle
     default: False
     manual: True

common base
  default-language: GHC2024
  ghc-options: -Wall
  default-extensions:
    DefaultSignatures
    NoImplicitPrelude
    OverloadedStrings
    TemplateHaskell
  build-depends:
    , base >=4.7 && < 5
    , relude >= 1.2.2 && < 2
    , tagged < 1

common server-base
  import: base
  if arch(wasm32)
    buildable: False

library vpn-router-api
  import: base
  hs-source-dirs: api
  exposed-modules:
    VpnRouter.Api
  build-depends:
    , file-embed              < 1
    , binary                  < 1
    , regex-tdfa              < 2
    , template-haskell        < 3
    , typelits-printf         < 1
    , unliftio                < 1
    -- , wai                     < 4

library
  import: server-base
  hs-source-dirs: src
  exposed-modules:
    VpnRouter.App
    VpnRouter.Bash
    VpnRouter.CmdArgs
    VpnRouter.CmdRun
    VpnRouter.Net
    VpnRouter.Net.Iptables
    VpnRouter.Net.IpTool
    VpnRouter.Net.Types
    VpnRouter.Page
    VpnRouter.Prelude
  other-modules:
    Paths_vpn_router
  autogen-modules:
    Paths_vpn_router
  build-depends:
    , aeson                   < 3
    , file-embed              < 1
    , binary                  < 1
    , blaze-markup            < 1
    , conduit                 < 2
    , conduit-extra           < 2
    , network                 < 4
    , optparse-applicative    < 1
    , regex-tdfa              < 2
    , template-haskell        < 3
    , trace-embrace           < 2
    , typelits-printf         < 1
    , unliftio                < 1
    , unix                    < 3
    , vpn-router-api
    , wai                     < 4
    , yesod-core              < 1.8


test-suite test
  import: server-base
  type: exitcode-stdio-1.0
  main-is: Driver.hs
  other-modules:
    VpnRouter.Test.Net
    Discovery
  hs-source-dirs:
    test
  ghc-options: -Wall -rtsopts -threaded -main-is Driver
  build-depends:
    , vpn-router
    , QuickCheck
    , tasty
    , tasty-discover
    , tasty-hunit
    , tasty-quickcheck

executable vpn-router
  import: server-base
  ghc-options: -Wall -threaded -with-rtsopts=-N
  main-is: VpnRouter.hs
  hs-source-dirs: app
  build-depends:
    , vpn-router

executable jsbundle
  import: base
  -- if flag(server-only)
  --   buildable: False
  if arch(wasm32)
    ghc-options:
      -Wall -no-hs-main -optl-mexec-model=reactor "-optl-Wl,--export=hs_start" -ddump-splices
    cpp-options:
       -DWASM
  hs-source-dirs:
    ui
  main-is:
    Main.hs
  build-depends:
    , base
    , miso
    , mtl
    , vpn-router-api
